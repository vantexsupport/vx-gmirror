{"id":"alphalaneous.alphas_geode_utils","repository":null,"featured":false,"download_count":4206426,"developers":[{"id":40,"username":"alphalaneous","display_name":"Alphalaneous","is_owner":true}],"versions":[{"name":"Alpha's Geode Utils","description":"Miscellaneous utilities for Geode Modding","version":"1.2.5","download_link":"https://api.geode-sdk.org/v1/mods/alphalaneous.alphas_geode_utils/versions/1.2.5/download","hash":"dbfcc734d0d7b158136f8504bbb551aa002b6a98d16d6a7dd7cec40f3450bb5a","geode":"5.6.0","download_count":1735924,"early_load":true,"requires_patching":false,"api":true,"mod_id":"alphalaneous.alphas_geode_utils","gd":{"win":"2.2081","android32":"2.2081","android64":"2.2081","mac-intel":"2.2081","mac-arm":"2.2081","ios":"2.2081"},"status":"accepted","created_at":"2026-04-11T00:39:26Z","updated_at":"2026-04-11T00:39:26Z"},{"name":"Alpha's Geode Utils","description":"Miscellaneous utilities for Geode Modding","version":"1.2.4","download_link":"https://api.geode-sdk.org/v1/mods/alphalaneous.alphas_geode_utils/versions/1.2.4/download","hash":"fbabb7d55edf633bbb00761b543093975d1b743b64cd4f79dd0d5fa353e7c901","geode":"5.3.0","download_count":567824,"early_load":true,"requires_patching":false,"api":true,"mod_id":"alphalaneous.alphas_geode_utils","gd":{"win":"2.2081","android32":"2.2081","android64":"2.2081","mac-intel":"2.2081","mac-arm":"2.2081","ios":"2.2081"},"status":"accepted","created_at":"2026-03-10T03:25:47Z","updated_at":"2026-03-10T03:25:47Z"},{"name":"Alpha's Geode Utils","description":"Miscellaneous utilities for Geode Modding","version":"1.2.3","download_link":"https://api.geode-sdk.org/v1/mods/alphalaneous.alphas_geode_utils/versions/1.2.3/download","hash":"39828a11ca61f275d9835c91ee93b87198832d4a8b3fdb022eb46846746d42c5","geode":"5.3.0","download_count":228941,"early_load":true,"requires_patching":false,"api":true,"mod_id":"alphalaneous.alphas_geode_utils","gd":{"win":"2.2081","android32":"2.2081","android64":"2.2081","mac-intel":"2.2081","mac