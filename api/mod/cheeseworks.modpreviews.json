08-08T22:21:02Z","updated_at":"2026-08-08T22:21:02Z"},{"name":"Mod Previews","description":"View preview images for mods.","version":"1.0.2","download_link":"https://api.geode-sdk.org/v1/mods/cheeseworks.modpreviews/versions/1.0.2/download","hash":"365555bc53284426f32642220063353872f5309b55289935953aa89545bf234c","geode":"5.8.0","download_count":937,"early_load":false,"requires_patching":false,"api":false,"mod_id":"cheeseworks.modpreviews","gd":{"win":"2.2081","android32":"2.2081","android64":"2.2081","mac-intel":"2.2081","mac-arm":"2.2081","ios":"2.2081"},"status":"accepted","created_at":"2026-08-08T15:23:25Z","updated_at":"2026-08-08T15:23:25Z"},{"name":"Mod Previews","description":"View preview images for mods.","version":"1.0.1","download_link":"https://api.geode-sdk.org/v1/mods/cheeseworks.modpreviews/versions/1.0.1/download","hash":"14494e43132cd89e22879f32ae43eb7901293677c44fa3a8a8467b3c1adda8b8","geode":"5.0.0","download_count":1346,"early_load":false,"requires_patching":false,"api":false,"mod_id":"cheeseworks.modpreviews","gd":{"win":"2.2081","android32":"2.2081","android64":"2.2081","mac-intel":"2.2081","mac-arm":"2.2081","ios":"2.2081"},"status":"accepted","created_at":"2026-08-08T02:14:35Z","updated_at":"2026-08-08T02:14:35Z"},{"name":"Mod Previews","description":"View preview images for mods.","version":"1.0.0","download_link":"https://api.geode-sdk.org/v1/mods/cheeseworks.modpreviews/versions/1.0.0/download","hash":"0070048a996b59b6a3cad52219768d9e18f2c0e969f86c4dc0f0af573c37f818","geode":"5.0.0","download_count":1015,"early_load":false,"requires_patching":false,"api":false,"mod_id":"cheeseworks.modpreviews","gd":{"win":"2.2081","android32":"2.2081","android64":"2.2081","mac-intel":"2.2081","mac-arm":"2.2081","ios":"2.2081"},"status":"accepted","created_at":"2026-08-07T18:42:23Z","updated_at":"2026-08-07T18:42:23Z"}],"tags":["online","enhancement","interface","utility"],"about":"# ![🖼](frame:GJ_shareBtn_001.png?scale=0.275) Mod Previews\n**View preview images for mods.**\n\n*by [Cheeseworks](user:6408873)!*\n\n---\n\n## About\nThis mod adds preview images to Geode mods' information pop-ups, *if their developer included them*!\n\n---\n\n### Viewing\nA <cg>small interface</c> should shortly <cy>appear at the bottom of the Geode mod information pop-up</c>, where you can view and go through pages of preview images for that mod.\n\n### Developers\nTo add preview images, first <cy>add a `previews/` folder to the root of your repository</c>, to which you will be able to add <cg>up to 10 PNG images</c> to preview your mod! <cr>Each preview image must be named with the following format</c>.\n\n> - `preview-`**`{num}`**`.png`\n\nFor example, `preview-4.png`, `preview-10.png`.\n\n#### Supported Platforms\nThis mod supports fetching images from repositories hosted on <cg>[GitHub](https://github.com/), [GitLab](https://gitlab.com/), and any [Forgejo-based platform](https://forgejo.org/)</c>.\n\n---\n\n### Credits\n- **[km7dev](user:7236822)**: Wrote a good chunk of the Geode v5 port\n\n---\n\n![🗨️](frame:gj_discordIcon_001.png?scale=0.375) **If you need help, join my [support Discord server](https://cwrk.cc/discord) and ask! :)**","changelog":"# v1.0.4 \n- Ported to Geometry Dash version `2.2091`\n  - Bumped Geode loader support to `v6.0.0`\n- Minor optimizations\n\n# v1.0.3 \n- Optimized internal Forgejo caching\n\n# v1.0.2 \n- Bumped Geode loader support to `v5.8.0`\n- Fix internal caching for Forgejo repositories\n\n# v1.0.1 \n- Internal tweaks\n\n# v1.0.0 \n- Initial release","created_at":"2026-08-07T18:50:10Z","updated_at":"2026-11-22T19:40:00Z","links":{"community":"https://cwrk.cc/discord","homepage":"https://www.cheeseworks.gay/","source":"https://github.com/Cheeseworks/ModPreviews"}}