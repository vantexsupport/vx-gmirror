_count":362,"early_load":false,"requires_patching":false,"api":false,"mod_id":"mat.draw-divide","gd":{"win":"*","android32":null,"android64":null,"mac-intel":null,"mac-arm":null,"ios":null},"status":"accepted","created_at":null,"updated_at":null},{"name":"Draw divide","description":"","version":"1.0.0","download_link":"https://api.geode-sdk.org/v1/mods/mat.draw-divide/versions/1.0.0/download","hash":"f7ca34b2808a859c506702fa6ecc9fecd919582b1295b4bc0705e67602242bca","geode":"2.0.0","download_count":370,"early_load":false,"requires_patching":false,"api":false,"mod_id":"mat.draw-divide","gd":{"win":"*","android32":null,"android64":null,"mac-intel":null,"mac-arm":null,"ios":null},"status":"accepted","created_at":null,"updated_at":null}],"tags":["universal","offline","performance"],"about":"# Draw Divide\r\n\r\nThis mod makes the game only render at your native refresh rate, even when you have an unlocked FPS, helping performance, specially for those with worse GPUs.\r\n\r\nThis works by only rendering the game at 60fps (or whatever your refresh rate is), while still running all the logic to whatever fps you set the game to.\r\n\r\nMeaning you get the benefit of fps bypass (lower input delay) while also not lagging as much due to rendering the game at such high fps.\r\n\r\nNote: Mods like [Click Between Frames](mod:syzzi.click_between_frames) and [Click on Steps](mod:zmx.cbf-lite) may offer the same benefit with greater perfomance.\r\n\r\nNote: The vanilla FPS counter will display the \"TPS\" and not the visual FPS count.\r\n\r\n## Usage\r\n\r\nThis mod is intended to be used with FPS bypass, such as the one included in the game.\r\n\r\nSet it to a high value to gain input precision while this mod keeps the visual FPS the same, helping performance.","changelog":null,"created_at":"2024-05-26T22:03:44Z","updated_at":"2026-02-20T00:11:24Z","links":{"community":null,"homepage":null,"source":"https://github.com/matcool/geode-mods"}}